-- Cache for materials and frequently used values
local MATERIAL_PLASTIC = Enum.Material.Plastic
local COLOR_TEXT_NORMAL = Color3.fromRGB(255, 255, 255)
local COLOR_TEXT_ACTIVE = Color3.fromRGB(255, 255, 255)
local COLOR_BUTTON_NORMAL = Color3.fromRGB(20, 20, 20)
local COLOR_BUTTON_HOVER = Color3.fromRGB(40, 40, 40)

-- Helper function to apply anti-lag settings to an instance
local function applyAntiLag(instance, ultraMode)
    if instance:IsA('ParticleEmitter') then
        instance.Enabled = false
    elseif instance:IsA('Decal') or instance:IsA('Texture') then
        instance.Transparency = 1
    elseif instance:IsA('BasePart') then
        instance.Material = MATERIAL_PLASTIC
        instance.Reflectance = 0
        instance.CastShadow = false
    end
end

local antiLagEnabled = false
local ultraModeEnabled = false
local connection = nil
local processedChunks = {} -- Track processed chunks to avoid duplicates

-- Function to update button colors
local function updateButtonColors()
    antiLagButton.TextColor3 = antiLagEnabled and COLOR_TEXT_ACTIVE or COLOR_TEXT_NORMAL
    ultraButton.TextColor3 = ultraModeEnabled and COLOR_TEXT_ACTIVE or COLOR_TEXT_NORMAL
end

-- Optimized workspace processing with chunking
local function processWorkspaceInChunks(processFunction, extraParam)
    local descendants = Workspace:GetDescendants()
    local chunkSize = 100
    local totalDescendants = #descendants

    for i = 1, totalDescendants, chunkSize do
        if not processedChunks[i] then
            processedChunks[i] = true
            task.spawn(function()
                for j = i, math.min(i + chunkSize - 1, totalDescendants) do
                    local descendant = descendants[j]
                    if extraParam ~= nil then
                        processFunction(descendant, extraParam)
                    else
                        processFunction(descendant)
                    end
                end
            end)
        end
    end
end

-- Function to enable/disable anti-lag
local function setAntiLag(state)
    antiLagEnabled = state
    antiLagButton.Text = antiLagEnabled and 'ANTI LAG: ON' or 'ANTI LAG: OFF'
    updateButtonColors()

    if antiLagEnabled then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0

        -- Process lighting effects
        for _, child in pairs(Lighting:GetChildren()) do
            if child:IsA('BloomEffect') or child:IsA('BlurEffect') or child:IsA('SunRaysEffect') or child:IsA('ColorCorrectionEffect') then
                child.Enabled = false
            end
        end

        -- Process workspace in chunks
        processedChunks = {}
        processWorkspaceInChunks(applyAntiLag, ultraModeEnabled)

        if connection then connection:Disconnect() end
        connection = Workspace.DescendantAdded:Connect(function(descendant)
            task.wait()
            applyAntiLag(descendant, ultraModeEnabled)
        end)
    else
        if connection then
            connection:Disconnect()
            connection = nil
        end
    end
end

-- Function to enable/disable ultra mode
local function setUltraMode(state)
    ultraModeEnabled = state
    ultraButton.Text = ultraModeEnabled and 'ULTRA MODE: ON' or 'ULTRA MODE: OFF'
    updateButtonColors()

    if ultraModeEnabled then
        -- Enable anti-lag automatically
        if not antiLagEnabled then
            setAntiLag(true)
        else
            -- Re-apply lighting settings
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            Lighting.Brightness = 1
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0

            for _, child in pairs(Lighting:GetChildren()) do
                if child:IsA('BloomEffect') or child:IsA('BlurEffect') or child:IsA('SunRaysEffect') then
                    child.Enabled = false
                end
            end
        end

        -- Process workspace with ultra mode
        processedChunks = {}
        local descendants = Workspace:GetDescendants()
        local chunkSize = 100
        local totalDescendants = #descendants

        for i = 1, totalDescendants, chunkSize do
            task.spawn(function()
                for j = i, math.min(i + chunkSize - 1, totalDescendants) do
                    local descendant = descendants[j]
                    applyAntiLag(descendant, true)
                    if descendant:IsA('Accessory') or descendant:IsA('Shirt') or descendant:IsA('Pants') or descendant:IsA('Hat') then
                        pcall(function() descendant:Destroy() end)
                    end
                end
            end)
        end
    end
end

